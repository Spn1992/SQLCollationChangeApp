#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DEBUG_DLL="$REPO_ROOT/MSBuildDiagnosticPatcher/bin/Debug/net8.0/MSBuildDiagnosticPatcher.dll"
RELEASE_DLL="$REPO_ROOT/MSBuildDiagnosticPatcher/bin/Release/net8.0/MSBuildDiagnosticPatcher.dll"

if [ -f "$DEBUG_DLL" ]; then
  exec dotnet "$DEBUG_DLL" "$@"
elif [ -f "$RELEASE_DLL" ]; then
  exec dotnet "$RELEASE_DLL" "$@"
else
  exec dotnet run --project "$REPO_ROOT/MSBuildDiagnosticPatcher/MSBuildDiagnosticPatcher.csproj" -p:UseSharedCompilation=false -- "$@"
fi
