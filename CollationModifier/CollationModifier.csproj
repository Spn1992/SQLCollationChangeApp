<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <_WpfTempProject Condition="'$(_WpfTempProject)' == '' and ($(MSBuildProjectFile.EndsWith('_wpftmp.csproj')) or '$(MSBuildProjectExtension)' == '.tmp_proj')">true</_WpfTempProject>
    <TargetFrameworks Condition="'$(_WpfTempProject)' != 'true'">net8.0;net8.0-windows</TargetFrameworks>
    <TargetFramework Condition="'$(_WpfTempProject)' == 'true' and '$(TargetFramework)' == ''">net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType Condition="'$(TargetFramework)' == 'net8.0-windows' or '$(_WpfTempProject)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' != 'net8.0-windows' and '$(_WpfTempProject)' != 'true'">Library</OutputType>
    <UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows' or '$(_WpfTempProject)' == 'true'">true</UseWPF>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CollationModifier</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CollationModifier.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows' and '$(_WpfTempProject)' != 'true'">
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="ErrorDetailsWindow.xaml.cs" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="App.xaml" />
    <Page Remove="MainWindow.xaml" />
    <Page Remove="ErrorDetailsWindow.xaml" />
  </ItemGroup>

</Project>
