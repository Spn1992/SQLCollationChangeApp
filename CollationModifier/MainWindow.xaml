<Window x:Class="CollationModifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CollationModifier.ViewModels"
        mc:Ignorable="d"
        Title="Collation Modifier Utility" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- Status Bar at the bottom -->
        <Border Background="#E2E8F0" Height="30" VerticalAlignment="Bottom" Grid.ZIndex="10">
            <DockPanel Margin="10,0">
                <Button x:Name="btnOpenLog" Content="Open Log File" Command="{Binding OpenLogCommand}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Height="24" Padding="8,2"
                        AutomationProperties.Name="Open Log File" ToolTip="Open execution log file or folder" />
                <Button x:Name="btnErrorDetails" Content="Details..." Command="{Binding ShowErrorDetailsCommand}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Height="22" Padding="8,2" Margin="0,0,8,0"
                        AutomationProperties.Name="Error Details" ToolTip="View detailed error information"
                        Visibility="{Binding HasDetailedError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusToolTip}" FontWeight="SemiBold" Foreground="#334155" />
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="100" Height="10" Margin="10,0,0,0"
                                 AutomationProperties.Name="Operation Progress"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Authentication Panel (Left) -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="24">
                <StackPanel>
                    <Label Content="Authentication" Style="{StaticResource CardHeader}" />

                    <TextBlock x:Name="ServerNameLabel" Text="Server Name" Margin="0,0,0,4" />
                    <TextBox x:Name="ServerNameInput" Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=ServerNameLabel}"
                             AutomationProperties.Name="Server Name"
                             Margin="0,0,0,16" IsEnabled="{Binding CanEditConnectionParameters}" />

                    <TextBlock x:Name="AuthTypeLabel" Text="Authentication Type" Margin="0,0,0,4" />
                    <ComboBox x:Name="AuthTypeInput" ItemsSource="{Binding AuthenticationTypes}"
                              SelectedItem="{Binding SelectedAuthenticationType}"
                              AutomationProperties.LabeledBy="{Binding ElementName=AuthTypeLabel}"
                              AutomationProperties.Name="Authentication Type"
                              Margin="0,0,0,16" IsEnabled="{Binding CanEditConnectionParameters}" />

                    <TextBlock x:Name="UsernameLabel" Text="Username" Margin="0,0,0,4" />
                    <TextBox x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=UsernameLabel}"
                             AutomationProperties.Name="Username"
                             Margin="0,0,0,16" IsEnabled="{Binding CanEditSqlCredentials}" />

                    <TextBlock x:Name="PasswordLabel" Text="Password" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBoxInput" Margin="0,0,0,24"
                                 AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                                 AutomationProperties.Name="Password"
                                 IsEnabled="{Binding CanEditSqlCredentials}"
                                 PasswordChanged="PasswordBox_PasswordChanged" />

                    <Button x:Name="btnConnect" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>

            <!-- Dashboard Panel (Right) -->
            <Border Grid.Column="1" Padding="32" Background="#F8FAFC">
                <Grid>
                    <!-- Overlay to disable interaction when not connected -->
                    <Border Background="#F8FAFC" Panel.ZIndex="5" Opacity="0.8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="lblDisconnectedOverlay" Text="Please connect to a server to continue."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#64748B" FontSize="16" />
                    </Border>

                    <StackPanel IsEnabled="{Binding IsConnected}">
                        <Label Content="Database Operations" Style="{StaticResource CardHeader}" FontSize="20" Margin="0,0,0,24" />

                        <!-- Database Selector -->
                        <TextBlock x:Name="SelectDatabaseLabel" Text="Select Database" Margin="0,0,0,8" FontWeight="SemiBold" />
                        <ComboBox x:Name="SelectDatabaseInput" ItemsSource="{Binding Databases}"
                                  SelectedItem="{Binding SelectedDatabase}" DisplayMemberPath="Name"
                                  AutomationProperties.LabeledBy="{Binding ElementName=SelectDatabaseLabel}"
                                  AutomationProperties.Name="Select Database"
                                  Margin="0,0,0,24" IsEnabled="{Binding IsNotBusy}" />

                        <!-- Metadata Panel -->
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,32"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Labels -->
                                <TextBlock x:Name="CurrentCollationLabel" Grid.Row="0" Grid.Column="0" Text="Current Collation:" FontWeight="SemiBold" Margin="0,0,16,12" />
                                <TextBlock x:Name="CompatibilityLevelLabel" Grid.Row="1" Grid.Column="0" Text="Compatibility Level:" FontWeight="SemiBold" Margin="0,0,16,12" />
                                <TextBlock x:Name="OwnerLabel" Grid.Row="2" Grid.Column="0" Text="Owner:" FontWeight="SemiBold" Margin="0,0,16,12" />
                                <TextBlock x:Name="SizeLabel" Grid.Row="3" Grid.Column="0" Text="Size:" FontWeight="SemiBold" />

                                <!-- Values -->
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDatabase.Collation, FallbackValue='-'}" Foreground="#475569" Margin="0,0,0,12"
                                           AutomationProperties.LabeledBy="{Binding ElementName=CurrentCollationLabel}"
                                           AutomationProperties.Name="Current Collation" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDatabase.CompatibilityLevel, FallbackValue='-'}" Foreground="#475569" Margin="0,0,0,12"
                                           AutomationProperties.LabeledBy="{Binding ElementName=CompatibilityLevelLabel}"
                                           AutomationProperties.Name="Compatibility Level" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDatabase.Owner, FallbackValue='-'}" Foreground="#475569" Margin="0,0,0,12"
                                           AutomationProperties.LabeledBy="{Binding ElementName=OwnerLabel}"
                                           AutomationProperties.Name="Owner" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDatabase.Size, FallbackValue='-'}" Foreground="#475569"
                                           AutomationProperties.LabeledBy="{Binding ElementName=SizeLabel}"
                                           AutomationProperties.Name="Size" />
                            </Grid>
                        </Border>

                        <!-- Action Area -->
                        <Label Content="Target Configuration" Style="{StaticResource CardHeader}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock x:Name="TargetCollationLabel" Text="New Collation Name" Margin="0,0,0,4" />
                                <TextBox x:Name="TargetCollationInput" Text="{Binding TargetCollation, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=TargetCollationLabel}"
                                         AutomationProperties.Name="New Collation Name"
                                         AutomationProperties.HelpText="E.g., SQL_Latin1_General_CP1_CI_AS"
                                         ToolTip="E.g., SQL_Latin1_General_CP1_CI_AS" IsEnabled="{Binding IsNotBusy}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="BackupDirectoryLabel" Text="Backup Directory (Server Host)" Margin="0,0,0,4"
                                           ToolTip="Path is evaluated on the SQL Server host filesystem, not the local client." />
                                <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNotBusy}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=BackupDirectoryLabel}"
                                         AutomationProperties.Name="Backup Directory (Server Host)"
                                         AutomationProperties.HelpText="Path is evaluated on the SQL Server host filesystem, not the local client."
                                         ToolTip="Path is evaluated on the SQL Server host filesystem, not the local client." />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Process Collation Change" Command="{Binding ProcessCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                            <Button x:Name="btnCancel" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="Cancel Operation" />
                        </StackPanel>

                        <TextBlock x:Name="lblWarning"
                                   Text="Warning: Modifying collation will set the database to SINGLE_USER mode briefly and may drop active connections."
                                   AutomationProperties.Name="Warning: Modifying collation will set the database to SINGLE_USER mode briefly and may drop active connections."
                                   AutomationProperties.HelpText="Database single user mode operation warning message."
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="#DC2626" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
</Window>
