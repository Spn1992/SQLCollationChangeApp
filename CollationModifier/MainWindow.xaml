<Window x:Class="CollationModifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xml:lang="en"
        Language="en-US"
        Title="Collation Modifier Utility" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Main Content Area -->
        <Grid Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Authentication Panel (Left) -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="24">
                <StackPanel>
                    <Label Content="Authentication" Style="{StaticResource CardHeader}" AutomationProperties.HeadingLevel="Level2" />

                    <TextBlock x:Name="ServerNameLabel" Text="Server Name" Margin="0,0,0,4" />
                    <TextBox x:Name="ServerNameInput" Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=ServerNameLabel}"
                             AutomationProperties.Name="Server Name"
                             Margin="0,0,0,16" IsEnabled="{Binding CanEditConnectionParameters}" />

                    <TextBlock x:Name="AuthTypeLabel" Text="Authentication Type" Margin="0,0,0,4" />
                    <ComboBox x:Name="AuthTypeInput" ItemsSource="{Binding AuthenticationTypes}"
                              SelectedItem="{Binding SelectedAuthenticationType}"
                              AutomationProperties.LabeledBy="{Binding ElementName=AuthTypeLabel}"
                              AutomationProperties.Name="Authentication Type"
                              Margin="0,0,0,16" IsEnabled="{Binding CanEditConnectionParameters}" />

                    <TextBlock x:Name="UsernameLabel" Text="Username" Margin="0,0,0,4" />
                    <TextBox x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=UsernameLabel}"
                             AutomationProperties.Name="Username"
                             Margin="0,0,0,16" IsEnabled="{Binding CanEditSqlCredentials}" />

                    <TextBlock x:Name="PasswordLabel" Text="Password" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBoxInput" Margin="0,0,0,24"
                                 AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                                 AutomationProperties.Name="Password"
                                 IsEnabled="{Binding CanEditSqlCredentials}"
                                 PasswordChanged="PasswordBox_PasswordChanged" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnConnect" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" IsDefault="{Binding CanEditConnectionParameters}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button x:Name="btnCancelConnect" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Cancel Connection" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dashboard Panel (Right) -->
            <Border Grid.Column="1" Padding="32" Background="#F8FAFC">
                <Grid>
                    <!-- Overlay to disable interaction when not connected -->
                    <Border Background="{StaticResource OverlayBackgroundBrush}" Panel.ZIndex="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="lblDisconnectedOverlay" Text="Please connect to a server to continue."
                                   AutomationProperties.Name="Please connect to a server to continue."
                                   AutomationProperties.LiveSetting="Polite"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource OverlayForegroundBrush}" FontSize="16" />
                    </Border>

                    <StackPanel IsEnabled="{Binding IsConnected}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Database Operations">
                        <Label Content="Database Operations" Style="{StaticResource CardHeader}" AutomationProperties.HeadingLevel="Level1" FontSize="20" Margin="0,0,0,24" />

                        <!-- Database Selector -->
                        <TextBlock x:Name="SelectDatabaseLabel" Text="Select Database" Margin="0,0,0,8" FontWeight="SemiBold" />
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SelectDatabaseInput" Grid.Column="0"
                                      ItemsSource="{Binding Databases}"
                                      SelectedItem="{Binding SelectedDatabase}" DisplayMemberPath="Name"
                                      AutomationProperties.LabeledBy="{Binding ElementName=SelectDatabaseLabel}"
                                      AutomationProperties.Name="Select Database"
                                      IsEnabled="{Binding IsNotBusy}" />
                            <Button x:Name="btnRefreshDatabases" Grid.Column="1"
                                    Content="Refresh"
                                    Command="{Binding RefreshDatabasesCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="24"
                                    Padding="12,6"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Refresh"
                                    AutomationProperties.HelpText="Reload database catalog from SQL Server"
                                    ToolTip="Reload database catalog from SQL Server" />
                        </Grid>

                        <!-- Metadata Panel -->
                        <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,32"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#CBD5E1" BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Labels -->
                                <TextBlock x:Name="DatabaseDefaultCollationLabel" Grid.Row="0" Grid.Column="0" Text="Database Default Collation:" FontWeight="SemiBold" Margin="0,0,16,12" />
                                <TextBlock x:Name="UserCharacterColumnsLabel" Grid.Row="1" Grid.Column="0" Text="User Character Columns:" FontWeight="SemiBold" Margin="0,0,16,12" />
                                <TextBlock x:Name="CompatibilityLevelLabel" Grid.Row="2" Grid.Column="0" Text="Compatibility Level:" FontWeight="SemiBold" Margin="0,0,16,12" />
                                <TextBlock x:Name="OwnerLabel" Grid.Row="3" Grid.Column="0" Text="Owner:" FontWeight="SemiBold" Margin="0,0,16,12" />
                                <TextBlock x:Name="SizeLabel" Grid.Row="4" Grid.Column="0" Text="Size:" FontWeight="SemiBold" />

                                <!-- Values -->
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDatabase.Collation, FallbackValue='-'}" Foreground="#475569" Margin="0,0,0,12"
                                           AutomationProperties.LabeledBy="{Binding ElementName=DatabaseDefaultCollationLabel}"
                                           AutomationProperties.Name="{Binding SelectedDatabase.Collation, StringFormat='Database Default Collation: {0}', FallbackValue='Database Default Collation: -', TargetNullValue='Database Default Collation: -'}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDatabase.UserCharacterColumns, FallbackValue='-'}" Foreground="#475569" Margin="0,0,0,12"
                                           AutomationProperties.LabeledBy="{Binding ElementName=UserCharacterColumnsLabel}"
                                           AutomationProperties.Name="{Binding SelectedDatabase.UserCharacterColumns, StringFormat='User Character Columns: {0}', FallbackValue='User Character Columns: -', TargetNullValue='User Character Columns: -'}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDatabase.CompatibilityLevel, FallbackValue='-'}" Foreground="#475569" Margin="0,0,0,12"
                                           AutomationProperties.LabeledBy="{Binding ElementName=CompatibilityLevelLabel}"
                                           AutomationProperties.Name="{Binding SelectedDatabase.CompatibilityLevel, StringFormat='Compatibility Level: {0}', FallbackValue='Compatibility Level: -', TargetNullValue='Compatibility Level: -'}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDatabase.Owner, FallbackValue='-'}" Foreground="#475569" Margin="0,0,0,12"
                                           AutomationProperties.LabeledBy="{Binding ElementName=OwnerLabel}"
                                           AutomationProperties.Name="{Binding SelectedDatabase.Owner, StringFormat='Owner: {0}', FallbackValue='Owner: -', TargetNullValue='Owner: -'}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDatabase.Size, FallbackValue='-'}" Foreground="#475569"
                                           AutomationProperties.LabeledBy="{Binding ElementName=SizeLabel}"
                                           AutomationProperties.Name="{Binding SelectedDatabase.Size, StringFormat='Size: {0}', FallbackValue='Size: -', TargetNullValue='Size: -'}" />
                            </Grid>
                        </Border>

                        <!-- Action Area -->
                        <Label Content="Target Configuration" Style="{StaticResource CardHeader}" AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,8" />

                        <StackPanel Margin="0,0,0,24">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="TargetCollationLabel" Text="New Collation Name" Margin="0,0,0,4" />
                                <ComboBox x:Name="TargetCollationInput"
                                          ItemsSource="{Binding SupportedCollations}"
                                          Text="{Binding TargetCollation, UpdateSourceTrigger=PropertyChanged}"
                                          Loaded="TargetCollationInput_Loaded"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          AutomationProperties.LabeledBy="{Binding ElementName=TargetCollationLabel}"
                                          AutomationProperties.Name="New Collation Name"
                                          AutomationProperties.HelpText="E.g., SQL_Latin1_General_CP1_CI_AS"
                                          ToolTip="E.g., SQL_Latin1_General_CP1_CI_AS" IsEnabled="{Binding IsNotBusy}">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock x:Name="BackupDirectoryLabel" Text="Backup Directory (Server Host)" Margin="0,0,0,4"
                                           ToolTip="Path is evaluated on the SQL Server host filesystem, not the local client." />
                                <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNotBusy}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=BackupDirectoryLabel}"
                                         AutomationProperties.Name="Backup Directory (Server Host)"
                                         AutomationProperties.HelpText="Path is evaluated on the SQL Server host filesystem, not the local client."
                                         ToolTip="Path is evaluated on the SQL Server host filesystem, not the local client." />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Process Collation Change" Command="{Binding ProcessCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                    AutomationProperties.DescribedBy="{Binding ElementName=lblWarning}"
                                    AutomationProperties.HelpText="Changes only the database default collation while leaving existing user columns unchanged, and sets the database to SINGLE_USER mode briefly which may drop active connections" />
                            <Button x:Name="btnCancel" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="Cancel Operation" />
                        </StackPanel>

                        <TextBlock x:Name="lblWarning"
                                   Text="Warning: This operation changes only the database default collation; existing columns in user tables keep their original collations and remain unchanged. Modifying collation will set the database to SINGLE_USER mode briefly and may drop active connections."
                                   AutomationProperties.Name="Warning: This operation changes only the database default collation; existing columns in user tables keep their original collations and remain unchanged. Modifying collation will set the database to SINGLE_USER mode briefly and may drop active connections."
                                   AutomationProperties.HelpText="Database default collation scope and single user mode warning message."
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="#B91C1C" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar at the bottom -->
        <Border Background="#E2E8F0" Height="30" VerticalAlignment="Bottom" Grid.ZIndex="10">
            <DockPanel Margin="10,0">
                <Button x:Name="btnOpenLog" Content="Open Log File" Command="{Binding OpenLogCommand}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Height="24" Padding="8,2"
                        AutomationProperties.Name="Open Log File" ToolTip="Open execution log file or folder" />
                <Button x:Name="btnErrorDetails" Content="Details..." Command="{Binding ShowErrorDetailsCommand}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Height="24" Padding="8,2" Margin="0,0,8,0"
                        AutomationProperties.Name="Details..."
                        AutomationProperties.HelpText="View detailed error information"
                        ToolTip="View detailed error information"
                        Visibility="{Binding HasDetailedError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusTextBlock" Grid.Column="0"
                               Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#334155"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding EffectiveStatusToolTip}"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Status Message" />
                    <ProgressBar Grid.Column="1"
                                 Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsIndeterminateProgress}" Minimum="0" Maximum="100" Width="100" Height="10" Margin="10,0,0,0"
                                 AutomationProperties.Name="Operation Progress"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
